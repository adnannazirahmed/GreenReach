# Runs locally with no credentials. Copy to .env and restart after editing.
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=./data/greenreach.db
# Required when binding outside loopback; paste this token into the login screen.
APP_TOKEN=
# Optional: local, genuinely open-source AI via Ollama. Pull a model separately.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Optional: cloud AI through the OpenAI Chat Completions API. Usage may incur charges.
# When both providers are configured, OpenAI takes precedence.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional OpenAI-compatible endpoint origin; default https://api.openai.com
OPENAI_BASE_URL=
# Optional key override. Otherwise a random key is created under DATABASE_PATH's directory.
CREDENTIALS_ENCRYPTION_KEY=
# Optional: authorized Reddit API access. Either supply a token or client credentials.
REDDIT_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=greenreach:0.1.0 (by /u/YOUR_USERNAME)
# Optional: Google organic search result discovery. Usage may incur provider charges.
SERPAPI_KEY=
# Optional GitHub token for higher API search limits. Public read-only API works without it.
GITHUB_TOKEN=
# Scheduler is OFF by default. Applies to projects with monitoring enabled.
SYNC_INTERVAL_MINUTES=0
